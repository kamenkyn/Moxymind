{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["@playwright/test", "node"]
  },
  "include": ["task_1/**/*.ts", "task_2/**/*.ts", "playwright.config.ts"]
}
