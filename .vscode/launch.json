{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright: Debug current test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/playwright/cli.js",
      "args": [
        "test",
        "${file}",
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Playwright: Debug all tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/playwright/cli.js",
      "args": [
        "test",
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
